{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-theme",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:window:allow-start-dragging",
    "notification:default",
    "log:default",
    "allow-credential-read",
    "allow-credential-write",
    "allow-credential-delete",
    "allow-get-desktop-lyrics-window-state",
    "allow-set-desktop-lyrics-visible",
    "allow-toggle-desktop-lyrics-visible",
    "allow-set-desktop-lyrics-locked",
    "allow-set-desktop-lyrics-fullscreen-behavior",
    "allow-update-media-metadata",
    "allow-update-media-playback",
    "allow-clear-media-session",
    "allow-hide-main-window",
    "allow-toggle-main-window-maximize",
    "allow-toggle-main-window-fullscreen",
    "allow-set-mini-mode"
  ]
}
